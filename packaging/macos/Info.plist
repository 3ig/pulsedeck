<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key><string>Pulsedeck</string>
	<key>CFBundleDisplayName</key><string>Pulsedeck</string>
	<key>CFBundleIdentifier</key><string>app.pulsedeck.server</string>
	<key>CFBundleExecutable</key><string>pulsedeck</string>
	<key>CFBundleIconFile</key><string>Pulsedeck</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>VERSION</string>
	<key>CFBundleVersion</key><string>VERSION</string>
	<key>LSMinimumSystemVersion</key><string>11.0</string>
	<!-- Menu-bar app: no Dock icon, no main window. -->
	<key>LSUIElement</key><true/>
	<key>NSHighResolutionCapable</key><true/>
	<key>NSLocalNetworkUsageDescription</key><string>Pulsedeck shares this Mac's system readings with your dashboards on the local network.</string>
	<key>NSBonjourServices</key><array><string>_pulsedeck._tcp</string></array>
	<key>NSAppleEventsUsageDescription</key><string>Pulsedeck uses this for the play, pause and track buttons you press on a dashboard.</string>
</dict>
</plist>
